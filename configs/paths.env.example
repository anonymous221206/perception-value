# Copy to configs/paths.env, edit, then `source configs/paths.env` before running anything.
# Every script locates data through these variables (src/rap/paths.py); nothing else is machine-specific.

# datasets root: nuscenes/trainval, kitti_tracking, nuplan (layout in data/README.md)
export RAP_DATASETS="$PWD/datasets"
# detector weights (yolov8s.pt, rtdetr-l.pt) and TensorRT engines (engines/)
export RAP_MODELS="$PWD/models"
# conda environment prefixes, used by environment/bin/py-edge and environment/bin/py-nuplan
export RAP_EDGE_PREFIX="$HOME/miniforge3/envs/edge"
export RAP_NUPLAN_PREFIX="$HOME/miniforge3/envs/nuplan"
# set to 1 to allow hardware-dependent steps on a non-reference device (outputs will differ from the paper)
# export RAP_ALLOW_OTHER_DEVICE=1
